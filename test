<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CARAT BINGO 2026</title>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@500;700;900&display=swap" rel="stylesheet">
    <style>
        :root { --rose: #F7CAC9; --serenity: #92A8D1; --bg-light: #FFF5F5; --dark: #2D2D2D; --card-bg: #FFFFFF; --glass: rgba(255, 255, 255, 0.3); }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { margin: 0; padding: 0; background-color: var(--bg-light); font-family: 'Noto Sans TC', sans-serif; color: var(--dark); display: flex; flex-direction: column; align-items: center; }
        
        .page { display: none; width: 100%; max-width: 1000px; animation: fadeIn 0.3s ease; }
        .page.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .container { width: 92%; margin: 15px auto; display: flex; flex-direction: column; gap: 15px; }

        /* --- Hero --- */
        .hero-section { display: grid; grid-template-columns: 1fr 1.2fr; background: var(--card-bg); border-radius: 30px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
        @media (max-width: 768px) { .hero-section { grid-template-columns: 1fr; } .hero-right { text-align: center; align-items: center; } }
        .hero-left { background: linear-gradient(135deg, var(--rose), var(--serenity)); display: flex; align-items: center; justify-content: center; padding: 25px; }
        .hero-right { padding: 25px; display: flex; flex-direction: column; justify-content: center; }
        .tag { background: var(--rose); color: white; padding: 3px 12px; border-radius: 20px; font-weight: 900; width: fit-content; margin-bottom: 8px; font-size: 0.75rem; }
        .hero-right h1 { font-size: 1.5rem; margin: 0; font-weight: 900; line-height: 1.2; }
        .hero-right h1 span { color: var(--serenity); display: block; }
        .hero-desc { font-size: 0.75rem; color: #888; font-weight: 700; margin-top: 8px; line-height: 1.5; }

        /* --- 指定版 Deadline Style --- */
        .deadline-card { background: var(--card-bg); border-radius: 15px; padding: 8px 15px; border-left: 6px solid var(--rose); text-align: center; display: flex; align-items: center; justify-content: center; gap: 10px; }
        .deadline-label { font-size: 0.6rem; color: #999; font-weight: 900; letter-spacing: 0.5px; }
        .deadline-date { font-size: 1.1rem; font-weight: 900; color: var(--dark); }
        .timer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
        .timer-box { background: var(--card-bg); border-radius: 15px; padding: 10px; text-align: center; border: 1.5px solid var(--serenity); }
        .timer-num { font-size: 1.2rem; font-weight: 900; display: block; }
        .timer-label { font-size: 0.6rem; color: #999; font-weight: 700; }

        /* --- Player Card --- */
        .player-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 10px 0; }
        .player-card { background: var(--card-bg); border-radius: 20px; padding: 15px 10px; text-align: center; cursor: pointer; }
        .avatar-box { width: 60px; height: 60px; background: #eee; border-radius: 50%; margin: 0 auto 10px; overflow: hidden; border: 2px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; position: relative; }
        .avatar-box img { width: 100% !important; height: 100% !important; object-fit: cover !important; border-radius: 50%; }

        /* --- Bingo Area --- */
        #bingo-capture-zone { 
            background: linear-gradient(135deg, var(--rose), var(--serenity)); 
            border-radius: 30px; padding: 45px 25px; 
            text-align: center; color: white; 
            position: relative; overflow: hidden; 
            transition: background 0.5s ease;
            display: flex; flex-direction: column; align-items: center;
        }
        .player-subtitle { font-size: 0.55rem; font-weight: 700; letter-spacing: 1.5px; opacity: 0.8; margin-top: 4px; margin-bottom: 12px; z-index: 3; position: relative; }
        
        #watermark-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
        .wm-style-top { position: absolute; top: 25px; left: 15px; width: 38%; opacity: 0.3; mix-blend-mode: screen; }
        .wm-style-mid { position: absolute; top: 58%; left: 50%; transform: translate(-50%, -50%); width: 21%; opacity: 0.3; mix-blend-mode: screen; }
        .wm-ran-top { width: 30% !important; }
        .wm-ran-mid { width: 18% !important; top: 70% !important; } 
        .wm-mirror { transform: translate(-50%, -50%) scaleX(-1) !important; }

        .bingo-board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; width: 100%; aspect-ratio: 1/1; margin-top: 5px; position: relative; z-index: 1; }
        
        .cell { 
            background: var(--glass); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); 
            border-radius: 18px; border: 1px solid rgba(255,255,255,0.4); 
            position: relative; overflow: hidden; cursor: pointer;
            display: flex; align-items: center; justify-content: center; 
        }
        .cell.marked { background: rgba(255,255,255,0.6); border: 3px solid white; }
        
        .cell textarea, .cell-text { 
            width: 100%; height: 100%;
            background: transparent; border: none; 
            font-weight: 900; color: white; outline: none; resize: none; 
            text-align: center;
            display: flex; align-items: center; justify-content: center; 
            padding: 8px;
            font-family: 'Noto Sans TC', sans-serif; 
            font-size: 0.75rem; 
            line-height: 1.3;
            z-index: 3;
            overflow: hidden;
            word-break: break-all;
            align-content: center;
        }

        .stamp-img { position: absolute; width: 35.3%; height: 35.3%; bottom: 5px; right: 5px; object-fit: contain; pointer-events: none; z-index: 5; transform: rotate(-5deg); }

        .controls { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 20px 0; }
        .btn { padding: 14px; border-radius: 50px; border: none; font-weight: 900; cursor: pointer; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; text-decoration: none; }
        .btn-rose { background: var(--rose); color: white !important; }
        .btn-serenity { background: var(--serenity); color: white !important; }
        .btn-white { background: white; border: 1px solid #eee; color: var(--dark) !important; width: fit-content !important; padding: 6px 15px !important; font-size: 0.75rem !important; margin-bottom: 5px; }

        .bias-toggle-btn { width: 65px; height: 65px; border-radius: 50%; border: 3px solid white; background: white; cursor: pointer; overflow: hidden; margin: 10px auto; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .bias-toggle-btn img { width: 90%; height: 90%; object-fit: contain; }

        /* --- Diary Modal --- */
        .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: none; align-items: center; justify-content: center; z-index: 2000; backdrop-filter: blur(5px); }
        .modal-content { background: white; padding: 25px; border-radius: 25px; width: 85%; max-width: 400px; text-align: center; border: 4px solid var(--serenity); box-shadow: 0 15px 40px rgba(0,0,0,0.2); }
        #note-title { margin: 0; font-size: 1.5rem; color: var(--serenity); font-weight: 900; }
        #note-input { width: 100%; height: 120px; margin: 15px 0; border-radius: 15px; padding: 12px; border: 2px solid #f0f0f0; outline: none; font-family: 'Noto Sans TC', sans-serif; resize: none; text-align: center; font-size: 0.9rem; }

        .rules-card { background: white; padding: 20px; border-radius: 20px; border-left: 5px solid var(--rose); margin-top: 5px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
        .rules-card h2 { margin: 0 0 10px; font-size: 1rem; font-weight: 900; color: var(--dark); }
        .rules-card ol { font-size: 0.75rem; line-height: 1.6; padding-left: 20px; margin: 0; color: #666; font-weight: 500; }
        
        #say-the-name { 
            position: absolute; 
            top: 50%; left: 50%; 
            transform: translate(-50%, -50%) scale(0); 
            z-index: 100; 
            pointer-events: none; 
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #say-the-name.active { transform: translate(-50%, -50%) scale(1) rotate(-10deg); }
        .explosion-box { background: white; color: var(--rose); font-weight: 900; font-size: 1.8rem; padding: 15px 30px; border: 6px solid var(--rose); box-shadow: 0 10px 30px rgba(0,0,0,0.2); white-space: nowrap; }
    </style>
</head>
